{
  "schemaVersion": 1,
  "id": "daedalon",
  "version": "${version}",
  "name": "ERYDON Daedalon",
  "description": "Freestanding classical decor and sculpture for Fabric.",
  "authors": [
    "Oliver"
  ],
  "license": "LicenseRef-Oliver-Restricted-1.0",
  "environment": "*",
  "icon": "assets/daedalon/icon.png",
  "entrypoints": {
    "modmenu": [
      "com.oliver.daedalon.client.config.DaedalonModMenuIntegration"
    ],
    "main": [
      "com.oliver.daedalon.Daedalon",
      "com.oliver.daedalon.glaux.GlauxMod"
    ],
    "client": [
      "com.oliver.daedalon.DaedalonClient",
      "com.oliver.daedalon.client.glaux.GlauxClient"
    ],
    "emi": [
      "com.oliver.daedalon.compat.emi.DaedalonEmiPlugin"
    ],
    "rei_client": [
      "com.oliver.daedalon.compat.rei.DaedalonReiClientPlugin"
    ]
  },
  "mixins": [
    "daedalon.mixins.json",
    {
      "config": "daedalon-texture-alias.mixins.json",
      "environment": "client"
    },
    {
      "config": "daedalon-glaux.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": ">=0.89.0",
    "minecraft": "1.20.1",
    "java": ">=17"
  },
  "recommends": {
    "sodium": "*",
    "indium": "*",
    "iris": "*"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "erydon:texture_alias_resolver": 1,
    "erydon:family_compatibility_generation": 2,
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/MaqUvVgTFm"
      }
    }
  }
}
